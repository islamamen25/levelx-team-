# ─────────────────────────────────────────────────────────────────────────────
# LevelX — Environment Variables
# Copy this file to .env.local and fill in your values.
# Add the same variables in your Cloudflare Workers dashboard:
#   Workers & Pages → levelx → Settings → Variables and Secrets
#
# Sections:
#   1) REQUIRED — the app will not build/run correctly without these.
#   2) OPTIONAL — features degrade gracefully if unset (search / AI).
#   3) PLANNED  — integrations described in CLAUDE.md but NOT yet wired in code.
#                 Left here so the names/format are agreed in advance. Commented
#                 out on purpose — uncomment when the integration is implemented.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1) REQUIRED
# ═════════════════════════════════════════════════════════════════════════════

# Supabase — Project Settings → API  (https://supabase.com/dashboard)
# URL is the public project endpoint; ANON_KEY is safe to expose to the browser
# (RLS is the security boundary). Project ref: xeylyyfmcucphggqwxdv
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cache-invalidation webhook secret — POST /api/revalidate (called by n8n).
# Must match the `x-webhook-secret` header n8n sends. Generate a strong secret:
#   openssl rand -hex 32
REVALIDATE_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# 2) OPTIONAL — search & AI (chat + semantic search work only when these are set)
# ═════════════════════════════════════════════════════════════════════════════

# OpenAI — chat completions AND text-embedding-3-small embeddings
OPENAI_API_KEY=

# Meilisearch — semantic / vector search backend
# INDEX_NAME defaults to "products" if unset.
MEILISEARCH_HOST=https://your-meili-instance.example.com
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_NAME=products


# ═════════════════════════════════════════════════════════════════════════════
# 3) PLANNED — integrations from CLAUDE.md §8, NOT referenced in code yet.
#    Keep commented until the corresponding integration is built.
# ═════════════════════════════════════════════════════════════════════════════

# Paymob (payments) — validate HMAC in the backend webhook before fulfilling.
#   Route (when built): app/api/webhooks/paymob/route.ts
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=

# Bosta (logistics) — create shipment ONLY after the payment webhook succeeds.
# BOSTA_API_KEY=
# BOSTA_BASE_URL=https://app.bosta.co/api/v2

# WhatsApp Business API (OTP / auth)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# NOT env vars — for reference only:
# The n8n webhook URL + secret used by the DB trigger notify_n8n_category_change()
# live as Postgres settings, not here:
#   app.n8n_webhook_url, app.n8n_webhook_secret
# Set via: ALTER DATABASE postgres SET app.n8n_webhook_url = '...';
# ─────────────────────────────────────────────────────────────────────────────
